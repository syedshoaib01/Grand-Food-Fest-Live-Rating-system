# ==============================================================================
# Grand Food Fest — Environment Configuration
# ==============================================================================

# Database Connection:
# Development: SQLite (local zero-config)
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL / Supabase / Neon):
# DATABASE_URL="postgresql://db_user:db_password@db_host:5432/grandfoodfest?sslmode=require"

# Session & JWT Signing Secret (Generate with: openssl rand -hex 32)
# Required in production for cryptographically signed HMAC attendee and admin tokens
ADMIN_JWT_SECRET="replace-with-a-cryptographically-secure-32-byte-hex-key"

# Pass Token Hashing Salt (Generate with: openssl rand -hex 16)
# Used to hash physical wristband/ticket passes into anonymous attendee identities
PASS_SALT="replace-with-a-random-salt-hex-value"

# Admin Initial Credentials (DEVELOPMENT ONLY)
# In production, admin credentials must be configured securely in the database
# or set via dedicated environment secret variables.
ADMIN_EMAIL="admin@grandfoodfest.com"
ADMIN_PASSWORD="replace-with-a-strong-configured-password"

# Developer Mode
# Set to "false" in staging/production to completely disable DevBar and demo passes.
NEXT_PUBLIC_DEV_MODE="true"
