# Grand Food Fest - Environment Variables

# Database: SQLite for local zero-config, PostgreSQL for production
# For PostgreSQL / Supabase, use: postgresql://postgres:password@localhost:5432/grandfoodfest
DATABASE_URL="file:./dev.db"

# Admin Authentication
ADMIN_EMAIL="admin@grandfoodfest.com"
ADMIN_PASSWORD="admin123"
ADMIN_JWT_SECRET="gff-secret-jwt-key-hyderabad-2026-very-secure"

# Pass Hashing Salt
PASS_SALT="gff-salt-2026-hyderabad"

# Developer Mode (Enables top bar pass switcher and quick event day selector)
NEXT_PUBLIC_DEV_MODE="true"
