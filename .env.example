# ==============================================================================
# Grand Food Fest — Environment Configuration Template
# ==============================================================================

# Database Connection (Supabase / PostgreSQL):
# Production Session Pooler (port 5432) or Transaction Pooler (port 6543):
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Session & JWT Signing Secret (Generate with: openssl rand -hex 32)
# Required in production for cryptographically signed HMAC attendee and admin tokens
ADMIN_JWT_SECRET="replace-with-a-cryptographically-secure-32-byte-hex-key"

# Pass Token Hashing Salt (Generate with: openssl rand -hex 16)
# Used to hash physical wristband/ticket passes into anonymous attendee identities
PASS_SALT="replace-with-a-random-salt-hex-value"

# Administrator Account Initial Credentials
ADMIN_EMAIL="admin@grandfoodfest.com"
ADMIN_PASSWORD="replace-with-a-strong-production-password"

# Developer Mode
# Must be set to "false" in staging and production to disable DevBar, demo passes, and dev tools.
NEXT_PUBLIC_DEV_MODE="false"

